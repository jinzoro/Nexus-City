# Copy this file to `.env` and paste your Supabase project values.
# Supabase Dashboard -> Project Settings -> API (or API Keys)
#
# New projects issue a publishable key (sb_publishable_...). Use that name:
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
#
# Older projects use the legacy anon JWT instead. The app also reads that name:
# VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
#
# Only ever use the publishable/anon key in the browser. Never the
# secret/service_role key.
